{
  "description": "Block shell loops/polling/monitoring and redirect to the dedicated Claude Code tools",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/guard.mjs\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
